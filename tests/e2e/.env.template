# Tiki E2E Test Environment Variables
# Copy this file to .env and fill in the values for your local setup.
# The test runner auto-loads this file — no CLI flags needed.
#
# Usage:
#   cp .env.template .env
#   # edit .env with your values, then run from tests/e2e/:
#   npx playwright test

# Base URL of your running Tiki instance.
# Subpath installs are supported: http://localhost/wiki works out of the box.
# The test runner extracts the subpath automatically — no extra config needed.
# Examples:
#   http://localhost           (Tiki at the server root)
#   http://localhost/wiki      (Tiki installed under /wiki — LAMP subpath)
#   https://tiki.ddev.site     (DDEV)
TIKI_BASE_URL=http://localhost

# PHP invocation prefix used to run fixture scripts (setup/teardown).
# Leave unset for auto-detection (DDEV worktree layout is detected automatically).
# Examples:
#   ddev exec php /var/www/html        (DDEV, project root)
#   php                                (plain PHP, run from Tiki root)
#   docker exec my-container php /var/www/html
#TIKI_FIXTURE_CMD=

# Admin credentials — must match the Tiki instance's admin account.
TIKI_ADMIN_USER=admin
TIKI_ADMIN_PASS=admin1234

# Registered (non-admin) test user — created by fixtures/create_test_users.php.
TIKI_TEST_USER=Test1
TIKI_TEST_PASS=test1pass

# ── Self-contained mode (dedicated test DB + PHP built-in server) ────────────
# Runs the suite against a disposable Tiki instance in THIS checkout, without
# any pre-existing web server or instance. This is what CI uses, and it
# guarantees the tests never touch a development database.
#
#   1. provision once:  tests/e2e/bin/e2e-provision.sh
#   2. run the suite:   TIKI_E2E_WEBSERVER=1 npx playwright test
#
# When TIKI_E2E_WEBSERVER=1, TIKI_BASE_URL is ignored (the spawned server is
# the target) and fixture scripts run with the host PHP.
# NOTE: e2e-provision.sh refuses to overwrite an existing db/local.php — use a
# fresh worktree/checkout for self-contained runs on a dev machine.
#TIKI_E2E_WEBSERVER=1
#TIKI_E2E_PORT=8686
#TIKI_E2E_DB_HOST=127.0.0.1
#TIKI_E2E_DB_NAME=tiki_e2e
#TIKI_E2E_DB_USER=tiki_e2e
#TIKI_E2E_DB_PASS=tiki_e2e
